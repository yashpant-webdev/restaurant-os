# Copy to services/<name>/.env for local runs. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

# --- payment service ---
# PORT=4002
# DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/payment_db
# DATABASE_URL=postgres://payment_app:CHANGE_ME@localhost:5432/payment_db
# DATABASE_WORKER_URL=postgres://payment_worker:CHANGE_ME@localhost:5432/payment_db
# PAYMENT_GATEWAY=fake            # or razorpay (test keys from dashboard.razorpay.com)
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- order service ---
# PORT=4001
# DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/order_db
# DATABASE_URL=postgres://order_app:CHANGE_ME@localhost:5432/order_db
# DATABASE_WORKER_URL=postgres://order_worker:CHANGE_ME@localhost:5432/order_db
# PAYMENT_SERVICE_URL=http://localhost:4002

# --- shared ---
JWT_MODE=hs256                    # production: jwks (Keycloak)
JWT_SECRET=replace-with-64-random-characters-for-local-dev-only
JWT_ISSUER=ros-local
JWT_AUDIENCE=ros-api
EVENT_BUS=kafka                   # two separate processes need a real broker
KAFKA_BROKERS=localhost:19092
CORS_ORIGINS=http://localhost:3000
