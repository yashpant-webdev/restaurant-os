{
  "name": "restaurant-os",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b packages/contracts packages/common services/payment services/order-pos services/analytics",
    "typecheck": "tsc -b packages/contracts packages/common services/payment services/order-pos services/analytics --noEmit false",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:int": "jest --runInBand --selectProjects integration",
    "demo": "npm run build && node scripts/demo/run.mjs"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "typescript": "5.7"
  }
}
